FROM python:3.13-slim

# Dossier de travail
WORKDIR /app

# Installer curl + dépendances de build minimales
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Installer uv (version stable)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Ajouter uv au PATH (installation standard)
ENV PATH="/root/.local/bin:/usr/local/bin:${PATH}"

# Copier SEULEMENT les fichiers de deps
COPY pyproject.toml uv.lock ./
# --no-install-project : le paquet local a besoin de src/, copié plus bas.
RUN uv sync --frozen --no-dev --extra web --no-install-project
# Copier le projet
COPY . .

# Installer les dépendances
RUN uv sync --frozen --no-dev --extra web

# Exposer le port Flet Web
EXPOSE 8000

# Lancer l'application (le serveur web a besoin de l'extra "web")
CMD ["uv", "run", "--extra", "web", "src/main.py"]
